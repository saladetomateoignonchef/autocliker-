<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_background"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/action_move_panel"
        android:padding="10dp"
        android:src="@drawable/ic_move" />

    <ImageButton
        android:id="@+id/playButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_start"
        android:src="@drawable/ic_play" />

    <ImageButton
        android:id="@+id/addButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_add_point"
        android:src="@drawable/ic_add" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_open_settings"
        android:src="@drawable/ic_tune" />

    <ImageButton
        android:id="@+id/closeButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_close_panel"
        android:src="@drawable/ic_close" />
</LinearLayout>
