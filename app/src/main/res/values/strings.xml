<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">AutoClicker</string>
    <string name="accessibility_description">Permet à AutoClicker d\'appuyer sur l\'écran à ta place aux endroits que tu as choisis, et d\'afficher son panneau flottant par-dessus les autres applications. L\'application ne lit pas le contenu de l\'écran.</string>

    <!-- Service -->
    <string name="section_service">Service</string>
    <string name="status_service_off">Le service d\'accessibilité est désactivé.</string>
    <string name="status_service_on">Service actif, prêt à cliquer.</string>
    <string name="status_running">Séquence en cours…</string>
    <string name="service_hint">Dans les réglages : Accessibilité → Applications installées → AutoClicker → Activer. Si Android affiche « Paramètre restreint », ouvre d\'abord les infos de l\'application (appui long sur l\'icône → Infos), puis le menu ⋮ → Autoriser les paramètres restreints.</string>
    <string name="action_enable_service">Activer le service</string>
    <string name="action_show_panel">Afficher le panneau flottant</string>
    <string name="action_hide_panel">Masquer le panneau flottant</string>

    <!-- Séquence -->
    <string name="section_sequence">Points de clic</string>
    <string name="sequence_help">Chaque point est une pastille numérotée à placer avec le panneau flottant. Appuie sur un point pour régler son déclenchement.</string>
    <string name="empty_points">Aucun point pour l\'instant.</string>
    <string name="action_add_point">Ajouter un point</string>
    <string name="summary_at_start">%1$s après le démarrage</string>
    <string name="summary_after_previous">%1$s après le point %2$d</string>
    <string name="summary_detail">Se déclenche à t = %1$s · appui %2$s · position (%3$d, %4$d)</string>

    <!-- Dialogue d'un point -->
    <string name="point_title">Point %1$d</string>
    <string name="trigger_label">Déclenchement</string>
    <string name="trigger_start">Compté depuis le démarrage de la séquence</string>
    <string name="trigger_previous">Quand le point précédent se déclenche</string>
    <string name="trigger_previous_n">Quand le point %1$d se déclenche</string>
    <string name="delay_after_start">Délai après le démarrage</string>
    <string name="delay_after_point">Délai après le point %1$d</string>
    <string name="delay_help">Un délai de 0 déclenche le point en même temps que sa référence : plusieurs points à 0 cliquent simultanément.</string>
    <string name="press_duration">Durée de l\'appui</string>
    <string name="point_position">Position : (%1$d, %2$d). Déplace la pastille sur l\'écran pour la changer.</string>
    <string name="action_save">Enregistrer</string>
    <string name="action_cancel">Annuler</string>
    <string name="action_delete">Supprimer</string>

    <!-- Répétition -->
    <string name="section_repeat">Répétition</string>
    <string name="repeat_infinite">En boucle jusqu\'à l\'arrêt</string>
    <string name="repeat_count">Nombre de passages</string>
    <string name="cycle_pause">Pause entre deux passages</string>

    <!-- Démarrage programmé -->
    <string name="section_schedule">Démarrage programmé</string>
    <string name="schedule_enable">Démarrer à une heure précise</string>
    <string name="schedule_time">Heure de démarrage</string>
    <string name="schedule_daily">Tous les jours</string>
    <string name="schedule_keep_screen">Garder l\'écran allumé en attendant</string>
    <string name="schedule_off">Aucun démarrage programmé.</string>
