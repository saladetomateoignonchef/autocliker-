    <string name="schedule_next">Prochain démarrage : %1$s</string>
    <string name="schedule_help">Les clics ne peuvent pas passer un écran verrouillé par code ou empreinte : laisse le téléphone déverrouillé sur l\'application visée, de préférence branché.</string>

